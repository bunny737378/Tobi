{
  "connectorId": "lol.anidap.connector",
  "displayName": "Anidap",
  "version": "1.0.0",
  "protocolVersion": 1,
  "maintainer": "tobi_providers",
  "summary": "HD Anime streaming with English Sub & Dub, multi-server HLS playback, soft subtitles, and intro/outro skip markers.",
  "iconUri": "https://anidap.lol/logo.png",
  "originUrl": "https://anidap.lol",
  "locales": ["en", "ja"],
  "matureContent": false,
  "features": {
    "feed": true,
    "catalogSearch": true,
    "dynamicFilters": true,
    "deferredSources": true,
    "downloads": false,
    "needsWebViewBridge": false
  },
  "defaultNet": {
    "headers": {
      "User-Agent": "Mozilla/5.0 (Linux; Android 14) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/130.0.0.0 Mobile Safari/537.36",
      "Referer": "https://anidap.lol/",
      "Origin": "https://anidap.lol",
      "Accept": "application/json"
    },
    "attachCookies": true,
    "lockUserAgent": true
  },
  "userConfigSchema": [
    {
      "key": "mirror_domain",
      "label": "Anidap Base URL",
      "inputType": "url",
      "required": false,
      "defaultValue": "https://anidap.lol"
    },
    {
      "key": "preferred_audio",
      "label": "Preferred Audio (sub or dub)",
      "inputType": "text",
      "required": false,
      "defaultValue": "sub"
    },
    {
      "key": "include_adult",
      "label": "Include 18+ Content (true or false)",
      "inputType": "text",
      "required": false,
      "defaultValue": "false"
    }
  ]
}
